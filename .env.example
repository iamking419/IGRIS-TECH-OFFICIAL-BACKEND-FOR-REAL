APP_NAME=Igris Tech Official Backend
DEBUG=true

# PostgreSQL Connection String (e.g. Railway: postgresql://postgres:password@postgres.railway.internal:5432/railway)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Admin Authentication
ADMIN_API_PASSWORD=change-me-in-production
# Optional: Pre-hashed admin password (bcrypt)
# ADMIN_PASSWORD_HASH=$2b$12$...

# JWT Security Configuration
JWT_SECRET_KEY=your-random-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
